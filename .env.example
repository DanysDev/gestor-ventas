# ============================================
# BACKEND - Variables de entorno
# Copia este archivo a .env y rellena los valores
# ============================================

# Entorno
NODE_ENV=production

# Puerto (Render usa 10000)
PORT=10000

# MongoDB Atlas - Connection String
# Formato: mongodb+srv://usuario:password@cluster.xxx.mongodb.net/gestor_ventas
MONGODB_URI=

# URL del frontend (para CORS)
# Ejemplo: https://tu-app.pages.dev
FRONTEND_URL=

# Directorio de imágenes (local development)
# En producción (Render) se usa /tmp/uploads que es temporal
IMAGES_DIR=/tmp/uploads

# ============================================
# CLOUDINARY (OPCIONAL - Para imágenes persistentes, sin tarjeta)
# Crea cuenta gratis en cloudinary.com y copia los 3 datos del Dashboard
# ============================================

# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# ============================================
# FRONTEND - Variables de entorno
# En frontend/.env.production
# ============================================

# URL de la API backend
# Ejemplo: https://tu-api.onrender.com/api
# API_URL=https://tu-api.onrender.com/api